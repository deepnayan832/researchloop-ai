PORT=8787
HOST=127.0.0.1
DATABASE_PATH=data/researchloop.sqlite

# Required in production. Use a long random value (at least 16 characters).
# The browser will show its native HTTP Basic Authentication prompt.
APP_ACCESS_PASSWORD=

# Set the externally visible origin when TLS terminates at a trusted proxy.
# Production requires an HTTPS origin with no path, e.g. https://research.example.com. Render falls back to RENDER_EXTERNAL_URL.
PUBLIC_ORIGIN=
# Set true only when the edge proxy overwrites X-Forwarded-For with the real client address.
TRUST_PROXY=false

# Per-IP sliding-window limits and global research concurrency cap.
MAX_CONCURRENT_RESEARCH_RUNS=3
RESEARCH_RUNS_PER_MINUTE=5
SESSION_REQUESTS_PER_MINUTE=10
# Set 0 to retain history indefinitely, or choose 1–3650 days for automatic cleanup.
RESEARCH_RETENTION_DAYS=0

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

TAVILY_API_KEY=

MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_BASE_URL=https://query1.finance.yahoo.com
MARKET_DATA_API_KEY=
